rement already satisfied: nvidia-cufile==1.15.1.6.* in /usr/local/lib/python3.13/dist-packages (from cuda-toolkit[cublas,cudart,cufft,cufile,cupti,curand,cusolver,cusparse,nvjitlink,nvrtc,nvtx]==13.0.2; platform_system == \"Linux\"->torch) (1.15.1.6)\nRequirement already satisfied: nvidia-cuda-cupti==13.0.85.* in /usr/local/lib/python3.13/dist-packages (from cuda-toolkit[cublas,cudart,cufft,cufile,cupti,curand,cusolver,cusparse,nvjitlink,nvrtc,nvtx]==13.0.2; platform_system == \"Linux\"->torch) (13.0.85)\nRequirement already satisfied: nvidia-curand==10.4.0.35.* in /usr/local/lib/python3.13/dist-packages (from cuda-toolkit[cublas,cudart,cufft,cufile,cupti,curand,cusolver,cusparse,nvjitlink,nvrtc,nvtx]==13.0.2; platform_system == \"Linux\"->torch) (10.4.0.35)\nRequirement already satisfied: nvidia-cusolver==12.0.4.66.* in /usr/local/lib/python3.13/dist-packages (from cuda-toolkit[cublas,cudart,cufft,cufile,cupti,curand,cusolver,cusparse,nvjitlink,nvrtc,nvtx]==13.0.2; platform_system == \"Linux\"->torch) (12.0.4.66)\nRequirement already satisfied: nvidia-cusparse==12.6.3.3.* in /usr/local/lib/python3.13/dist-packages (from cuda-toolkit[cublas,cudart,cufft,cufile,cupti,curand,cusolver,cusparse,nvjitlink,nvrtc,nvtx]==13.0.2; platform_system == \"Linux\"->torch) (12.6.3.3)\nRequirement already satisfied: nvidia-nvjitlink==13.0.88.* in /usr/local/lib/python3.13/dist-packages (from cuda-toolkit[cublas,cudart,cufft,cufile,cupti,curand,cusolver,cusparse,nvjitlink,nvrtc,nvtx]==13.0.2; platform_system == \"Linux\"->torch) (13.0.88)\nRequirement already satisfied: nvidia-cuda-nvrtc==13.0.88.* in /usr/local/lib/python3.13/dist-packages (from cuda-toolkit[cublas,cudart,cufft,cufile,cupti,curand,cusolver,cusparse,nvjitlink,nvrtc,nvtx]==13.0.2; platform_system == \"Linux\"->torch) (13.0.88)\nRequirement already satisfied: nvidia-nvtx==13.0.85.* in /usr/local/lib/python3.13/dist-packages (from cuda-toolkit[cublas,cudart,cufft,cufile,cupti,curand,cusolver,cusparse,nvjitlink,nvrtc,nvtx]==13.0.2; platform_system == \"Linux\"->torch) (13.0.85)\nRequirement already satisfied: cuda-pathfinder~=1.1 in /usr/local/lib/python3.13/dist-packages (from cuda-bindings<14,>=13.0.3->torch) (1.8.4)\nRequirement already satisfied: numpy in /usr/local/lib/python3.13/dist-packages (from torchvision) (2.1.3)\nRequirement already satisfied: pillow!=8.3.*,>=5.3.0 in /usr/local/lib/python3.13/dist-packages (from torchvision) (13.0.0)\nRequirement already satisfied: mpmath<1.4,>=1.1.0 in /usr/local/lib/python3.13/dist-packages (from sympy>=1.13.3->torch) (1.3.0)\nRequirement already satisfied: MarkupSafe>=2.0 in /usr/local/lib/python3.13/dist-packages (from jinja2->torch) (3.0.4)\nDownloading snntorch-1.0.0-py2.py3-none-any.whl (133 kB)\nInstalling collected packages: snntorch\nSuccessfully installed snntorch-1.0.0\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"import os\nimport glob\nimport json\nimport random\nfrom collections import defaultdict\nimport cv2\nimport numpy as np\nimport torch\nfrom torch.utils.data import Dataset, DataLoader\n\n# 1. Quét đường dẫn toàn bộ ảnh trong /kaggle/input\nINPUT_DIR = \"/kaggle/input\"\nall_files = glob.glob(os.path.join(INPUT_DIR, \"**/*\"), recursive=True)\nimage_path_map = {\n    os.path.basename(f): f \n    for f in all_files \n    if os.path.isfile(f) and os.path.splitext(f)[1].lower() in ['.jpg', '.jpeg', '.png']\n}\nprint(f\"Tổng số ảnh tìm thấy: {len(image_path_map)}\")\n\nTRAIN_JSON = \"/kaggle/input/datasets/sepehrhonarparvar/uit-adrone-yolo/train.json\"\nTEST_JSON = \"/kaggle/input/datasets/sepehrhonarparvar/uit-adrone-yolo/test.json\"\n\n# 2. Định nghĩa class Dataset\nclass UITADroneCropSNNDataset(Dataset):\n    def __init__(self, json_path, image_path_map, img_size=(64, 64), min_box_size=16):\n        self.crops = []\n        self.img_size = img_size\n\n        with open(json_path, 'r') as f:\n            coco_data = json.load(f)\n\n        id_to_fname = {img['id']: os.path.basename(img['file_name']) for img in coco_data['images']}\n        cat_ids = sorted([cat['id'] for cat in coco_data['categories']])\n        self.cat_map = {cid: idx for idx, cid in enumerate(cat_ids)}\n        self.idx_to_name = {\n            idx: cat['name'] \n            for idx, cat in enumerate(sorted(coco_data['categories'], key=lambda x: x['id']))\n        }\n        self.num_classes = len(cat_ids)\n\n        for ann in coco_data['annotations']:\n            fname = id_to_fname.get(ann['image_id'])\n            if fname in image_path_map:\n                x, y, w, h = ann['bbox']\n                if w >= min_box_size and h >= min_box_size:\n                    self.crops.append((\n                        image_path_map[fname],\n                        [int(x), int(y), int(w), int(h)],\n                        self.cat_map[ann['category_id']]\n                    ))\n\n    def __len__(self):\n        return len(self.crops)\n\n    def __getitem__(self, idx):\n        img_path, (x, y, w, h), label = self.crops[idx]\n        img = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)\n        \n        H, W = img.shape\n        x1, y1 = max(0, x), max(0, y)\n        x2, y2 = min(W, x + w), min(H, y + h)\n        crop = img[y1:y2, x1:x2]\n\n        resized = cv2.resize(crop, self.img_size, interpolation=cv2.INTER_AREA)\n        tensor_img = torch.from_numpy(resized.astype(np.float32) / 255.0).unsqueeze(0)\n        return tensor_img, torch.tensor(label, dtype=torch.long)\n\n# 3. Hàm cân bằng số lượng mẫu mỗi lớp\ndef balance_dataset_crops(dataset_obj, max_per_class=4000, seed=42):\n    random.seed(seed)\n    by_class = defaultdict(list)\n    for item in dataset_obj.crops:\n        by_class[item[2]].append(item)\n    \n    balanced_crops = []\n    print(f\"\\n--- Phân bố sau khi cân bằng (tối đa {max_per_class} mẫu/lớp) ---\")\n    for cid in sorted(by_class.keys()):\n        items = by_class[cid]\n        if len(items) > max_per_class:\n            items = random.sample(items, max_per_class)\n        balanced_crops.extend(items)\n        print(f\"  - Class {cid} ({dataset_obj.idx_to_name[cid]}): {len(items)} mẫu\")\n    \n    random.shuffle(balanced_crops)\n    dataset_obj.crops = balanced_crops\n\n# 4. Khởi tạo, cân bằng và tạo DataLoader\ntrain_dataset = UITADroneCropSNNDataset(TRAIN_JSON, image_path_map, img_size=(64, 64), min_box_size=16)\ntest_dataset = UITADroneCropSNNDataset(TEST_JSON, image_path_map, img_size=(64, 64), min_box_size=16)\n\nbalance_dataset_crops(train_dataset, max_per_class=4000)\nbalance_dataset_crops(test_dataset, max_per_class=1000)\n\ntrain_loader = DataLoader(train_dataset, batch_size=64, shuffle=True, num_workers=4, pin_memory=True)\ntest_loader = DataLoader(test_dataset, batch_size=64, shuffle=False, num_workers=4, pin_memory=True)\n\nprint(f\"\\n[OK] Sẵn sàng train! Tổng batch Train: {len(train_loader)} | Tổng batch Test: {len(test_loader)}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T14:23:58.274359Z","iopub.execute_input":"2026-11-17T14:23:58.274695Z","iopub.status.idle":"2026-11-17T14:28:08.30789Z","shell.execute_reply.started":"2026-11-17T14:23:58.274657Z","shell.execute_reply":"2026-11-17T14:28:08.307184Z"}},"outputs":[{"name":"stdout","text":"Tổng số ảnh tìm thấy: 5609\n\n--- Phân bố sau khi cân bằng (tối đa 4000 mẫu/lớp) ---\n  - Class 0 (bus): 4000 mẫu\n  - Class 1 (car): 4000 mẫu\n  - Class 2 (bike): 1404 mẫu\n  - Class 3 (ped): 4000 mẫu\n  - Class 4 (motorbike): 4000 mẫu\n  - Class 5 (truck): 4000 mẫu\n  - Class 6 (tricycle): 2600 mẫu\n  - Class 7 (van): 4000 mẫu\n\n--- Phân bố sau khi cân bằng (tối đa 1000 mẫu/lớp) ---\n  - Class 0 (bus): 1000 mẫu\n  - Class 1 (car): 1000 mẫu\n  - Class 2 (bike): 1000 mẫu\n  - Class 3 (ped): 1000 mẫu\n  - Class 4 (motorbike): 1000 mẫu\n  - Class 5 (truck): 1000 mẫu\n  - Class 6 (tricycle): 1000 mẫu\n  - Class 7 (van): 1000 mẫu\n\n[OK] Sẵn sàng train! Tổng batch Train: 438 | Tổng batch Test: 125\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"!pip install snntorch -q\n\nimport torch\nimport torch.nn as nn\nimport snntorch as snn\nfrom snntorch import surrogate\n\nspike_grad = surrogate.fast_sigmoid(slope=25)\n\nclass UITADroneCSNN(nn.Module):\n    def __init__(self, num_classes=8, beta=0.5):\n        super().__init__()\n        # Input: [Batch, 1, 64, 64]\n        # Khối tích chập 1: 64x64 -> 32x32 (stride=2 thay cho MaxPool để nhẹ cho Pi 4)\n        self.conv1 = nn.Conv2d(1, 16, kernel_size=3, stride=2, padding=1)\n        self.lif1 = snn.Leaky(beta=beta, spike_grad=spike_grad)\n        \n        # Khối tích chập 2: 32x32 -> 16x16\n        self.conv2 = nn.Conv2d(16, 32, kernel_size=3, stride=2, padding=1)\n        self.lif2 = snn.Leaky(beta=beta, spike_grad=spike_grad)\n        \n        # Khối tích chập 3: 16x16 -> 8x8\n        self.conv3 = nn.Conv2d(32, 32, kernel_size=3, stride=2, padding=1)\n        self.lif3 = snn.Leaky(beta=beta, spike_grad=spike_grad)\n        \n        # Flatten: 32 * 8 * 8 = 2048\n        self.fc1 = nn.Linear(32 * 8 * 8, 128)\n        self.lif4 = snn.Leaky(beta=beta, spike_grad=spike_grad)\n        \n        self.fc2 = nn.Linear(128, num_classes)\n        self.lif5 = snn.Leaky(beta=beta, spike_grad=spike_grad)\n\n    def forward(self, x, num_steps=10):\n        # Khởi tạo trạng thái điện thế màng\n        mem1 = self.lif1.init_leaky()\n        mem2 = self.lif2.init_leaky()\n        mem3 = self.lif3.init_leaky()\n        mem4 = self.lif4.init_leaky()\n        mem5 = self.lif5.init_leaky()\n        \n        spk5_rec = []\n        \n        for _ in range(num_steps):\n            cur1 = self.conv1(x)\n            spk1, mem1 = self.lif1(cur1, mem1)\n            \n            cur2 = self.conv2(spk1)\n            spk2, mem2 = self.lif2(cur2, mem2)\n            \n            cur3 = self.conv3(spk2)\n            spk3, mem3 = self.lif3(cur3, mem3)\n            \n            flat = spk3.view(spk3.size(0), -1)\n            cur4 = self.fc1(flat)\n            spk4, mem4 = self.lif4(cur4, mem4)\n            \n            cur5 = self.fc2(spk4)\n            spk5, mem5 = self.lif5(cur5, mem5)\n            \n            spk5_rec.append(spk5)\n            \n        return torch.stack(spk5_rec, dim=0)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T14:28:08.308753Z","iopub.execute_input":"2026-11-17T14:28:08.309045Z","iopub.status.idle":"2026-11-17T14:28:10.058931Z","shell.execute_reply.started":"2026-11-17T14:28:08.309026Z","shell.execute_reply":"2026-11-17T14:28:10.057868Z"}},"outputs":[],"execution_count":3},{"cell_type":"code","source":"device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nmodel = UITADroneCSNN(num_classes=8, beta=0.5).to(device)\n\ncriterion = nn.CrossEntropyLoss()\noptimizer = torch.optim.Adam(model.parameters(), lr=1e-3)\nscheduler = torch.optim.lr_scheduler.StepLR(optimizer, step_size=5, gamma=0.5)\n\nNUM_STEPS = 10\nEPOCHS = 20\nbest_acc = 0.0\n\nprint(f\"Bắt đầu huấn luyện CSNN trên thiết bị: {device}\")\n\nfor epoch in range(EPOCHS):\n    model.train()\n    train_loss = 0.0\n    correct_train = 0\n    total_train = 0\n    \n    for data, targets in train_loader:\n        data, targets = data.to(device), targets.to(device)\n        \n        optimizer.zero_grad()\n        spk_out = model(data, num_steps=NUM_STEPS)\n        \n        # Tổng hợp số xung đầu ra theo chiều thời gian\n        sum_spikes = torch.sum(spk_out, dim=0)\n        loss = criterion(sum_spikes, targets)\n        \n        loss.backward()\n        optimizer.step()\n        \n        train_loss += loss.item()\n        _, predicted = torch.max(sum_spikes, 1)\n        total_train += targets.size(0)\n        correct_train += (predicted == targets).sum().item()\n        \n    scheduler.step()\n    train_acc = 100.0 * correct_train / total_train\n    \n    # Đánh giá trên tập Test\n    model.eval()\n    correct_test = 0\n    total_test = 0\n    with torch.no_grad():\n        for data, targets in test_loader:\n            data, targets = data.to(device), targets.to(device)\n            spk_out = model(data, num_steps=NUM_STEPS)\n            sum_spikes = torch.sum(spk_out, dim=0)\n            _, predicted = torch.max(sum_spikes, 1)\n            total_test += targets.size(0)\n            correct_test += (predicted == targets).sum().item()\n            \n    test_acc = 100.0 * correct_test / total_test\n    print(f\"Epoch [{epoch+1:02d}/{EPOCHS:02d}] | Loss: {train_loss/len(train_loader):.4f} | Train Acc: {train_acc:.2f}% | Test Acc: {test_acc:.2f}%\")\n    \n    if test_acc > best_acc:\n        best_acc = test_acc\n        torch.save(model.state_dict(), \"best_uit_adrone_csnn.pth\")\n        print(f\"  --> Đã lưu mô hình tốt nhất (Test Acc: {best_acc:.2f}%)\")\n\nprint(f\"\\nHoàn tất huấn luyện! Độ chính xác cao nhất trên tập Test: {best_acc:.2f}%\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T14:28:10.060403Z","iopub.execute_input":"2026-11-17T14:28:10.060993Z","iopub.status.idle":"2026-11-17T15:56:46.078242Z","shell.execute_reply.started":"2026-11-17T14:28:10.060967Z","shell.execute_reply":"2026-11-17T15:56:46.077292Z"}},"outputs":[{"name":"stdout","text":"Bắt đầu huấn luyện CSNN trên thiết bị: cuda\nEpoch [01/20] | Loss: 2.0794 | Train Acc: 14.28% | Test Acc: 12.50%\n  --> Đã lưu mô hình tốt nhất (Test Acc: 12.50%)\nEpoch [02/20] | Loss: 2.0897 | Train Acc: 14.19% | Test Acc: 12.50%\nEpoch [03/20] | Loss: 2.0599 | Train Acc: 16.62% | Test Acc: 17.27%\n  --> Đã lưu mô hình tốt nhất (Test Acc: 17.27%)\nEpoch [04/20] | Loss: 1.9966 | Train Acc: 21.54% | Test Acc: 17.15%\nEpoch [05/20] | Loss: 1.9966 | Train Acc: 22.14% | Test Acc: 16.57%\nEpoch [06/20] | Loss: 2.0044 | Train Acc: 22.03% | Test Acc: 17.54%\n  --> Đã lưu mô hình tốt nhất (Test Acc: 17.54%)\nEpoch [07/20] | Loss: 1.9704 | Train Acc: 24.45% | Test Acc: 19.61%\n  --> Đã lưu mô hình tốt nhất (Test Acc: 19.61%)\nEpoch [08/20] | Loss: 1.9572 | Train Acc: 25.16% | Test Acc: 18.02%\nEpoch [09/20] | Loss: 1.9532 | Train Acc: 25.34% | Test Acc: 18.55%\nEpoch [10/20] | Loss: 1.9472 | Train Acc: 25.29% | Test Acc: 18.77%\nEpoch [11/20] | Loss: 1.9152 | Train Acc: 26.61% | Test Acc: 21.30%\n  --> Đã lưu mô hình tốt nhất (Test Acc: 21.30%)\nEpoch [12/20] | Loss: 1.9059 | Train Acc: 26.90% | Test Acc: 19.81%\nEpoch [13/20] | Loss: 1.8946 | Train Acc: 27.30% | Test Acc: 20.48%\nEpoch [14/20] | Loss: 1.8881 | Train Acc: 27.25% | Test Acc: 20.56%\nEpoch [15/20] | Loss: 1.8809 | Train Acc: 27.81% | Test Acc: 19.89%\nEpoch [16/20] | Loss: 1.8836 | Train Acc: 27.93% | Test Acc: 21.11%\nEpoch [17/20] | Loss: 1.8732 | Train Acc: 28.00% | Test Acc: 21.64%\n  --> Đã lưu mô hình tốt nhất (Test Acc: 21.64%)\nEpoch [18/20] | Loss: 1.8581 | Train Acc: 28.97% | Test Acc: 22.15%\n  --> Đã lưu mô hình tốt nhất (Test Acc: 22.15%)\nEpoch [19/20] | Loss: 1.8540 | Train Acc: 29.05% | Test Acc: 22.01%\nEpoch [20/20] | Loss: 1.8503 | Train Acc: 28.74% | Test Acc: 21.94%\n\nHoàn tất huấn luyện! Độ chính xác cao nhất trên tập Test: 22.15%\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"import torch\nimport numpy as np\nimport zipfile\n\n# Chuyển toàn bộ mô hình về CPU và bật chế độ eval\nmodel.load_state_dict(torch.load(\"best_uit_adrone_csnn.pth\", map_location=\"cpu\"))\nmodel.to(\"cpu\")\nmodel.eval()\n\nlayers = {\n    \"conv1_w\": model.conv1.weight.detach().cpu().numpy().astype(np.float32),\n    \"conv1_b\": model.conv1.bias.detach().cpu().numpy().astype(np.float32),\n    \"conv2_w\": model.conv2.weight.detach().cpu().numpy().astype(np.float32),\n    \"conv2_b\": model.conv2.bias.detach().cpu().numpy().astype(np.float32),\n    \"conv3_w\": model.conv3.weight.detach().cpu().numpy().astype(np.float32),\n    \"conv3_b\": model.conv3.bias.detach().cpu().numpy().astype(np.float32),\n    \"fc1_w\":   model.fc1.weight.detach().cpu().numpy().astype(np.float32),\n    \"fc1_b\":   model.fc1.bias.detach().cpu().numpy().astype(np.float32),\n    \"fc2_w\":   model.fc2.weight.detach().cpu().numpy().astype(np.float32),\n    \"fc2_b\":   model.fc2.bias.detach().cpu().numpy().astype(np.float32),\n}\n\nwith zipfile.ZipFile(\"uit_adrone_csnn.zip\", \"w\") as zf:\n    for name, arr in layers.items():\n        fname = f\"{name}.npy\"\n        np.save(fname, arr)\n        zf.write(fname)\n        print(f\"Đã xuất {fname}: shape={arr.shape}\")\n\nprint(\"\\n[OK] Đã xuất và nén thành công uit_adrone_csnn.zip!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T16:10:41.412501Z","iopub.execute_input":"2026-11-17T16:10:41.413549Z","iopub.status.idle":"2026-11-17T16:10:41.437283Z","shell.execute_reply.started":"2026-11-17T16:10:41.41352Z","shell.execute_reply":"2026-11-17T16:10:41.436356Z"}},"outputs":[{"name":"stdout","text":"Đã xuất conv1_w.npy: shape=(16, 1, 3, 3)\nĐã xuất conv1_b.npy: shape=(16,)\nĐã xuất conv2_w.npy: shape=(32, 16, 3, 3)\nĐã xuất conv2_b.npy: shape=(32,)\nĐã xuất conv3_w.npy: shape=(32, 32, 3, 3)\nĐã xuất conv3_b.npy: shape=(32,)\nĐã xuất fc1_w.npy: shape=(128, 2048)\nĐã xuất fc1_b.npy: shape=(128,)\nĐã xuất fc2_w.npy: shape=(8, 128)\nĐã xuất fc2_b.npy: shape=(8,)\n\n[OK] Đã xuất và nén thành công uit_adrone_csnn.zip!\n","output_type":"stream"}],"execution_count":9}]}